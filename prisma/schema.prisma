generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["auth", "public"]
}

// ------------------------------------------------------
// ESQUEMA AUTH: Únicamente el modelo 'users' necesario para auditoría
// ------------------------------------------------------
model users {
  id                                        String        @id @db.Uuid
  email                                     String?       @db.VarChar(255)
  created_at                                DateTime?     @db.Timestamptz(6)
  updated_at                                DateTime?     @db.Timestamptz(6)
  
  // Relaciones con tus tablas de negocio
  categorias_categorias_created_byTousers   categorias[]  @relation("categorias_created_byTousers")
  categorias_categorias_updated_byTousers   categorias[]  @relation("categorias_updated_byTousers")
  comodidades_comodidades_created_byTousers comodidades[] @relation("comodidades_created_byTousers")
  comodidades_comodidades_updated_byTousers comodidades[] @relation("comodidades_updated_byTousers")
  listings_listings_created_byTousers       listings[]    @relation("listings_created_byTousers")
  listings_listings_deleted_byTousers       listings[]    @relation("listings_deleted_byTousers")
  listings_listings_updated_byTousers       listings[]    @relation("listings_updated_byTousers")

  @@schema("auth")
}

// ------------------------------------------------------
// ESQUEMA PUBLIC: Tus tablas del negocio
// ------------------------------------------------------
model listings {
  id                               String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre                           String                @db.VarChar(255)
  ubicacion                        String                @db.VarChar(255)
  precio_por_noche                 Decimal               @db.Decimal(12, 2)
  moneda                           String?               @default("COP") @db.VarChar(10)
  capacidad_huespedes              Int                   @default(1)
  capacidad_habitaciones           Int                   @default(1)
  capacidad_camas                  Int                   @default(1)
  capacidad_banos                  Int                   @default(1)
  clima_tipo                       String?               @db.VarChar(50)
  clima_temperatura_media          String?               @db.VarChar(20)
  calificacion_puntuacion          Decimal?              @default(0.00) @db.Decimal(3, 2)
  calificacion_resenas_conteo      Int?                  @default(0)
  fotos                            Json                  @default("[]")
  videos                           Json                  @default("[]")
  tiene_video                      Boolean?              @default(false)
  opcion_reserva                   String                @default("Bajo Solicitud") @db.VarChar(50)
  cancelacion_gratuita             Boolean?              @default(false)
  state                            String                @default("ACTIVO") @db.VarChar(50)
  created_by                       String?               @db.Uuid
  updated_by                       String?               @db.Uuid
  deleted_by                       String?               @db.Uuid
  created_at                       DateTime?             @default(now()) @db.Timestamptz(6)
  updated_at                       DateTime?             @default(now()) @db.Timestamptz(6)
  deleted_at                       DateTime?             @db.Timestamptz(6)
  listing_categorias               listing_categorias[]
  listing_comodidades              listing_comodidades[]
  users_listings_created_byTousers users?                @relation("listings_created_byTousers", fields: [created_by], references: [id], onUpdate: NoAction)
  users_listings_deleted_byTousers users?                @relation("listings_deleted_byTousers", fields: [deleted_by], references: [id], onUpdate: NoAction)
  users_listings_updated_byTousers users?                @relation("listings_updated_byTousers", fields: [updated_by], references: [id], onUpdate: NoAction)

  @@index([id], map: "idx_listings_active", where: raw("((state)::text = 'ACTIVO'::text)"))
  @@index([fotos], map: "idx_listings_fotos", type: Gin)
  @@index([state], map: "idx_listings_state")
  @@index([videos], map: "idx_listings_videos", type: Gin)
  @@schema("public")
}

model comodidades {
  id                                  Int                   @id @default(autoincrement())
  nombre                              String                @unique @db.VarChar(100)
  descripcion                         String?
  created_by                          String?               @db.Uuid
  updated_by                          String?               @db.Uuid
  users_comodidades_created_byTousers users?                @relation("comodidades_created_byTousers", fields: [created_by], references: [id], onUpdate: NoAction)
  users_comodidades_updated_byTousers users?                @relation("comodidades_updated_byTousers", fields: [updated_by], references: [id], onUpdate: NoAction)
  listing_comodidades                 listing_comodidades[]

  @@schema("public")
}

model categorias {
  id                                 Int                  @id @default(autoincrement())
  nombre                             String               @unique @db.VarChar(100)
  descripcion                        String?
  created_by                         String?              @db.Uuid
  updated_by                         String?              @db.Uuid
  users_categorias_created_byTousers users?               @relation("categorias_created_byTousers", fields: [created_by], references: [id], onUpdate: NoAction)
  users_categorias_updated_byTousers users?               @relation("categorias_updated_byTousers", fields: [updated_by], references: [id], onUpdate: NoAction)
  listing_categorias                 listing_categorias[]

  @@schema("public")
}

model listing_comodidades {
  listing_id   String      @db.Uuid
  comodidad_id Int
  comodidades  comodidades @relation(fields: [comodidad_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_lc_comodidad")
  listings     listings    @relation(fields: [listing_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_lc_listing")

  @@id([listing_id, comodidad_id])
  @@schema("public")
}

model listing_categorias {
  listing_id   String     @db.Uuid
  categoria_id Int
  categorias   categorias @relation(fields: [categoria_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_lcat_categoria")
  listings     listings   @relation(fields: [listing_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_lcat_listing")

  @@id([listing_id, categoria_id])
  @@schema("public")
}